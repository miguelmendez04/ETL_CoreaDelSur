# Copiar a .env y completar. El archivo .env no se versiona.

# UN World Population Prospects - token gratuito (sin restricción de país):
# https://population.un.org/dataportalapi/token/index.html
UNWPP_API_TOKEN=

# PostgreSQL (los mismos valores usa docker-compose.yml para crear la base)
PG_HOST=localhost
PG_PORT=5432
PG_DB=etl_corea
PG_USER=postgres
PG_PASSWORD=

# World Bank y OECD no requieren credenciales.
# KOSIS no se usa por API (la OpenAPI está restringida a residentes de Corea): ver README, "Extracción".

# Airflow (opcional, perfil "airflow" de docker-compose): clave interna entre sus componentes, >= 64 caracteres.
# Si se deja vacía se usa una clave de desarrollo; solo importa si Airflow se expone fuera del PC.
AIRFLOW_JWT_SECRET=
