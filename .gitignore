# Credenciales
.env

# Archivos de datos locales (no se versionan; solo se conserva la estructura)
data/*/*
!data/*/.gitkeep
# Excepción: las descargas manuales de KOSIS sí se versionan (~2 MB). Su OpenAPI está restringida a residentes
# de Corea, así que sin estos CSV nadie más podría reproducir la extracción. Las demás fuentes se re-descargan por API.
!data/bronze/kosis/

# Logs de ejecución
logs/*
!logs/.gitkeep

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Notebooks
.ipynb_checkpoints/

# Power BI
*.pbix.bak

# Notas locales de Claude (no se versionan)
CLAUDE.md

# Power BI: caché de datos importados y configuración local del proyecto .pbip
powerbi/**/.pbi/cache.abf
powerbi/**/.pbi/localSettings.json
