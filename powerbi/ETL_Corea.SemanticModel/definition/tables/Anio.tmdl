/// Eje común de años (2000-2072) para unir histórico y futuro en un mismo gráfico
table Anio
	lineageTag: 518d55f9-ffb1-5cb2-ad87-a0f3daf5942c

	column anio
		dataType: int64
		formatString: 0
		lineageTag: 120b46e5-2e02-5933-9e6c-a76abbd3a6a1
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = Automatic

	partition Anio = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Datos = Origen{[Schema = "gold", Item = "v_anios"]}[Data]
				in
				    Datos

	annotation PBI_ResultType = Table

