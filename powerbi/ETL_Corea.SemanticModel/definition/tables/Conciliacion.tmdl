		summarizeBy: none
		sourceColumn: indicador

		annotation SummarizationSetBy = Automatic

	column dentro_tolerancia
		dataType: boolean
		lineageTag: d9b3965b-318e-5e01-ad0a-d19675fe0d46
		summarizeBy: none
		sourceColumn: dentro_tolerancia

		annotation SummarizationSetBy = Automatic

	partition Conciliacion = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Datos = Origen{[Schema = "gold", Item = "v_conciliacion"]}[Data],
				    Columnas = Table.SelectColumns(Datos, {"nivel", "anio", "cod_territorio", "sexo", "grupo_edad", "cod_indicador", "escenario", "fuente_maestra", "fuente_contraste", "valor_maestra", "valor_contraste", "dif_abs", "dif_pct", "indicador", "dentro_tolerancia"})
				in
				    Columnas

	annotation PBI_ResultType = Table

