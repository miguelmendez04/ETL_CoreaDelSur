/// Conciliación maestra vs contraste
table Conciliacion
	lineageTag: 146c394d-a568-55b9-a8b1-533d8ea8180d

	measure 'Pares dentro de ±3 %' = DIVIDE(CALCULATE(COUNTROWS(Conciliacion), Conciliacion[dentro_tolerancia] = TRUE(), Conciliacion[nivel] = "historico"), CALCULATE(COUNTROWS(Conciliacion), Conciliacion[nivel] = "historico"))
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 39f5d5a1-4c9b-5fc6-ad87-44afc8614aaa

	column nivel
		dataType: string
		lineageTag: 2b8ebc19-4a31-5deb-8243-2ab2e3d794c6
		summarizeBy: none
		sourceColumn: nivel

		annotation SummarizationSetBy = Automatic

	column anio
		dataType: int64
		formatString: 0
		lineageTag: 1adf18ad-4e1d-5a66-89ab-fbc169c67207
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = Automatic

	column cod_territorio
		dataType: string
		lineageTag: 8aeaebb8-78fe-54a1-8cae-5d050866a5d6
		summarizeBy: none
		sourceColumn: cod_territorio

		annotation SummarizationSetBy = Automatic

	column sexo
		dataType: string
		lineageTag: 8a972672-b5a0-559b-9d77-5f63b0b0c7a6
		summarizeBy: none
		sourceColumn: sexo

		annotation SummarizationSetBy = Automatic

	column grupo_edad
		dataType: string
		lineageTag: 973a7d98-2d3c-5a10-9fac-1e7bfe1bf223
		summarizeBy: none
		sourceColumn: grupo_edad

		annotation SummarizationSetBy = Automatic

	column cod_indicador
		dataType: string
		lineageTag: 31beb706-8060-5d0b-8c97-082ecf96032a
		summarizeBy: none
		sourceColumn: cod_indicador

		annotation SummarizationSetBy = Automatic

	column escenario
		dataType: string
		lineageTag: a21fb594-d125-5ce1-a640-fb3d9edbb4df
		summarizeBy: none
		sourceColumn: escenario

		annotation SummarizationSetBy = Automatic

	column fuente_maestra
		dataType: string
		lineageTag: ff4082cf-81b9-5d06-b4d0-47665a6b3e00
		summarizeBy: none
		sourceColumn: fuente_maestra

		annotation SummarizationSetBy = Automatic

	column fuente_contraste
		dataType: string
		lineageTag: 0b0343df-4f34-5190-9ab1-6829e1a728a0
		summarizeBy: none
		sourceColumn: fuente_contraste

		annotation SummarizationSetBy = Automatic

	column valor_maestra
		dataType: double
		formatString: #,0.00
		lineageTag: 128441c2-62fc-56df-92d2-01f862a62b32
		summarizeBy: average
		sourceColumn: valor_maestra

		annotation SummarizationSetBy = Automatic

	column valor_contraste
		dataType: double
		formatString: #,0.00
		lineageTag: 988f7fec-0e8c-5657-beff-2cdf9a5b53c9
		summarizeBy: average
		sourceColumn: valor_contraste

		annotation SummarizationSetBy = Automatic

	column dif_abs
		dataType: double
		formatString: #,0.00
		lineageTag: f5d72062-75c8-52b4-b6e7-93127b0189b9
		summarizeBy: average
		sourceColumn: dif_abs

		annotation SummarizationSetBy = Automatic

	column dif_pct
		dataType: double
		formatString: #,0.00
		lineageTag: 127b9d75-c69c-551a-9af6-7bddabccceb1
		summarizeBy: average
		sourceColumn: dif_pct

		annotation SummarizationSetBy = Automatic

	column indicador
