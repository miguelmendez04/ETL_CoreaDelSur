	partition Escenarios = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Datos = Origen{[Schema = "gold", Item = "v_escenarios_resumen"]}[Data]
				in
				    Datos

	annotation PBI_ResultType = Table

