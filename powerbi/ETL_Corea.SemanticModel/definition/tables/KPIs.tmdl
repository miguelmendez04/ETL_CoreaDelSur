/// KPIs de calidad de la última ejecución
table KPIs
	lineageTag: ff465dcf-8c7b-5a87-b4d7-76c661c35bbb

	measure 'KPIs cumplidos' = CALCULATE(COUNTROWS(KPIs), KPIs[cumple] = TRUE())
		formatString: 0
		lineageTag: ab06a908-ea16-50aa-b9b7-9abc032e2b2b

	measure 'KPIs totales' = COUNTROWS(KPIs)
		formatString: 0
		lineageTag: ab2fa68b-d5d2-5ea2-aa24-6aa1a8eaa647

	measure 'KPIs cumplidos (texto)' = FORMAT([KPIs cumplidos], "0") & " de " & FORMAT([KPIs totales], "0")
		lineageTag: f1ec3d82-5e5d-54ef-9374-bab2d68a0666

	column kpi
		dataType: string
		lineageTag: 48d90740-6d61-5c23-a0e4-4a140b0b2e57
		summarizeBy: none
		sourceColumn: kpi

		annotation SummarizationSetBy = Automatic

	column valor
		dataType: double
		formatString: #,0.00
		lineageTag: 097b9317-5cbd-5514-b5f5-5faa9993d030
		summarizeBy: none
		sourceColumn: valor

		annotation SummarizationSetBy = Automatic

	column meta
		dataType: string
		lineageTag: 7264da9e-6abb-50f5-9559-66ad2b125c6c
		summarizeBy: none
		sourceColumn: meta

		annotation SummarizationSetBy = Automatic

	column cumple
		dataType: boolean
		lineageTag: 021e8fd4-8c88-51ec-ba83-59b70a9b4c47
		summarizeBy: none
		sourceColumn: cumple

		annotation SummarizationSetBy = Automatic

	column detalle
		dataType: string
		lineageTag: f3ecd976-551b-586b-86c9-63eba39c8932
		summarizeBy: none
		sourceColumn: detalle

		annotation SummarizationSetBy = Automatic

	partition KPIs = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Datos = Origen{[Schema = "gold", Item = "v_kpis_calidad"]}[Data],
				    Columnas = Table.SelectColumns(Datos, {"kpi", "valor", "meta", "cumple", "detalle"})
				in
				    Columnas

	annotation PBI_ResultType = Table

