	partition Panel = m
		mode: import
		source =
				let
				    Origen = PostgreSQL.Database(Servidor, BaseDatos),
				    Datos = Origen{[Schema = "gold", Item = "v_panel_indicadores"]}[Data],
				    Columnas = Table.SelectColumns(Datos, {"nivel", "escenario", "anio", "cod_territorio", "tfr", "nacimientos", "poblacion_total", "pob_0_14", "pob_15_64", "pob_65mas", "prop_65mas", "indice_envejecimiento", "dependencia_vejez", "pob_activa", "ocupados", "tasa_participacion", "tasa_desempleo", "pib_hora", "pib_ocupado", "tiene_preliminares"})
				in
