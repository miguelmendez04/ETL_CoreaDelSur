/// Preguntas 1, 3, 4 y 9: un registro por año × territorio
table Panel
	lineageTag: 669a996b-d20a-5421-8c3c-7eb715ba44a9

	measure 'TFR 2025' = CALCULATE(MAX(Panel[tfr]), REMOVEFILTERS(Territorio), Panel[cod_territorio] = "00", Panel[anio] = 2025)
		formatString: 0.00
		lineageTag: 51b67c3c-5c90-5897-ba82-1f7305ca6e76

	measure 'Nacimientos 2000' = CALCULATE(MAX(Panel[nacimientos]), REMOVEFILTERS(Territorio), Panel[cod_territorio] = "00", Panel[anio] = 2000)
		formatString: #,0
		lineageTag: fb75136a-0441-5b76-a980-4e2e1248b871

	measure 'Nacimientos 2025' = CALCULATE(MAX(Panel[nacimientos]), REMOVEFILTERS(Territorio), Panel[cod_territorio] = "00", Panel[anio] = 2025)
		formatString: #,0
		lineageTag: e13620ef-466b-583e-9629-45f4528ad409

	measure 'Variación nacimientos 2000-2025' = DIVIDE([Nacimientos 2025], [Nacimientos 2000]) - 1
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: 2682499b-c6f1-5eed-91a2-40ab03cf7d6e

	measure 'Proporción 65+ 2025' = CALCULATE(MAX(Panel[prop_65mas]), REMOVEFILTERS(Territorio), Panel[cod_territorio] = "00", Panel[anio] = 2025) / 100
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: ab21722f-f795-549e-9cac-5abe9d2cc882

	measure 'Dependencia de vejez 2025' = CALCULATE(MAX(Panel[dependencia_vejez]), REMOVEFILTERS(Territorio), Panel[cod_territorio] = "00", Panel[anio] = 2025)
		formatString: 0.0
		lineageTag: f199e357-7b80-5602-8ce0-f6303264beae

	measure 'Población activa 2025' = CALCULATE(MAX(Panel[pob_activa]), REMOVEFILTERS(Territorio), Panel[cod_territorio] = "00", Panel[anio] = 2025)
		formatString: #,0
		lineageTag: 2b3e242b-2b23-5a43-9e91-52c046f0692e

	measure 'Observada (EAPS)' = CALCULATE(SUM(Panel[pob_activa]), Panel[cod_territorio] = "00", Panel[nivel] = "historico") / 1000000
		formatString: 0.0
		displayFolder: Presentación
		lineageTag: 4956f663-2b79-5497-a908-25887ff00475

	measure 'Estimada (KOSIS)' = CALCULATE(SUM(Panel[pob_15_64]), Panel[cod_territorio] = "00", Panel[nivel] = "historico") / 1000000
		formatString: 0.0
		displayFolder: Presentación
		lineageTag: 7a4965b7-0f12-5c3c-93a7-96a9f51c6beb

