table pbi_calidad
	lineageTag: 177618ab-d9ab-45e6-bd92-f5a0bbe06c84

	measure 'Registros válidos (%)' = DIVIDE(SUM(pbi_calidad[registros_validos]), SUM(pbi_calidad[registros_evaluados])) * 100
		formatString: 0.00
		lineageTag: 77a2676a-6c2e-4db4-8d6d-ae8cee1483b1

	measure 'Rechazo (%)' = DIVIDE(SUM(pbi_calidad[registros_rechazados]), SUM(pbi_calidad[registros_evaluados])) * 100
