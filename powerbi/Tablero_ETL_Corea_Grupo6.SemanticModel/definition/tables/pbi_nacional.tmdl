/// Una fila por año (2000-2072), Corea del Sur. Vitales y laborales observados; población estimada hasta 2022 y desde la proyección KOSTAT medio después (columna tipo_dato_poblacion).
table pbi_nacional
	lineageTag: ec805930-3dd8-4f8f-97f7-344ce34732d7

	/// Tasa global de fecundidad (observado, KOSIS)
	measure 'Fecundidad (TFR)' = SUM(pbi_nacional[TFR])
		formatString: 0.00
		lineageTag: b51daeb4-e2fa-45d8-b733-97d9d4bb12ce

	/// Referencia demográfica: 2,1 hijos por mujer
	measure 'Nivel de reemplazo' = IF(NOT ISBLANK([Fecundidad (TFR)]), 2.1)
		formatString: 0.0
		lineageTag: e7933b13-5865-4a1f-bd21-f327b835ae81

	/// Nacidos vivos (observado)
	measure 'Nacimientos (miles)' = DIVIDE(SUM(pbi_nacional[NACIMIENTOS]), 1000)
		formatString: #,0
		lineageTag: ac719d26-a289-41b1-9644-59c5adad8875

	/// Defunciones (observado)
	measure 'Defunciones (miles)' = DIVIDE(SUM(pbi_nacional[DEFUNCIONES]), 1000)
		formatString: #,0
		lineageTag: 3ec35a9f-c100-4668-8c86-b0a5f8b90afc

	/// Años (observado)
	measure 'Esperanza de vida' = SUM(pbi_nacional[ESPERANZA_VIDA])
		formatString: 0.0
		lineageTag: fa457392-c8ea-4c7f-8fcb-fea30d9657c8

	/// Estimado ≤2022 · proyección KOSTAT medio ≥2023
	measure '% 0-14' = SUM(pbi_nacional[PROP_0_14])
		formatString: 0.0
		lineageTag: 77b59054-ec76-4930-9fbb-5f8c2e848dd1

	/// Estimado ≤2022 · proyección KOSTAT medio ≥2023
	measure '% 15-64' = SUM(pbi_nacional[PROP_15_64])
		formatString: 0.0
		lineageTag: 52d781e4-fdc1-4f2c-98d4-b8fe8f06e6fa

	/// Estimado ≤2022 · proyección KOSTAT medio ≥2023
	measure '% 65+' = SUM(pbi_nacional[PROP_65MAS])
		formatString: 0.0
		lineageTag: 4359ab24-37e7-4051-bff3-ef2ffbf3e5b4

	/// P65+/P15-64×100 sobre población estimada (≤2022), calculada en el pipeline
	measure 'Dependencia de vejez · estimada' = CALCULATE(SUM(pbi_nacional[DEP_VEJEZ]), pbi_nacional[tipo_dato_poblacion] = "estimado")
		formatString: 0.0
		lineageTag: e5753c48-db5e-4617-8b01-4dcd2d749c80

	/// Proyección oficial KOSTAT (escenario medio) desde 2023; arranca en 2022
	measure 'Dependencia de vejez · proyección' = CALCULATE(SUM(pbi_nacional[DEP_VEJEZ]), pbi_nacional[anio] >= 2022)
		formatString: 0.0
		lineageTag: 9d414319-52a8-45d4-ace0-29cceba00622

	measure 'Población 15-64 · estimada' = CALCULATE(DIVIDE(SUM(pbi_nacional[POB_15_64]), 1e6), pbi_nacional[tipo_dato_poblacion] = "estimado")
		formatString: #,0.0" M"
		lineageTag: 8dca2da0-c476-44f1-b37c-fd61a73b9e5a

	measure 'Población 15-64 · proyección' = CALCULATE(DIVIDE(SUM(pbi_nacional[POB_15_64]), 1e6), pbi_nacional[anio] >= 2022)
		formatString: #,0.0" M"
		lineageTag: a59869ee-6579-40da-a425-7175cfce389e

	/// Jóvenes 15-24 por cada 100 personas de 55-64
	measure 'Reemplazo laboral · estimado' = CALCULATE(SUM(pbi_nacional[IND_REEMPLAZO_LABORAL]), pbi_nacional[tipo_dato_poblacion] = "estimado")
		formatString: 0
		lineageTag: 741bb432-de20-48e8-94eb-8cadf3b57b3e

	measure 'Reemplazo laboral · proyección' = CALCULATE(SUM(pbi_nacional[IND_REEMPLAZO_LABORAL]), pbi_nacional[anio] >= 2022)
		formatString: 0
		lineageTag: 3cb011e8-2f8d-4878-ad35-000053cc63fe

	measure 'Referencia 100' = IF(NOT ISBLANK([Reemplazo laboral · estimado]) || NOT ISBLANK([Reemplazo laboral · proyección]), 100)
		formatString: 0
		lineageTag: 05cd670f-9d62-4167-9d14-c80e30ca2e27

	/// EAPS, promedio anual
	measure 'Población activa observada' = DIVIDE(SUM(pbi_nacional[POB_ACTIVA]), 1e6)
		formatString: #,0.0" M"
		lineageTag: 89bf5139-4445-4d50-950f-d13ea8539290

	/// USD PPA constantes (OECD)
	measure 'PIB por hora' = SUM(pbi_nacional[PIB_HORA])
		formatString: 0.0
		lineageTag: bdbbfe81-fc66-4a14-8ceb-c68e8743cf8e

	/// EAPS (observado)
	measure 'Participación laboral 15+' = SUM(pbi_nacional[TASA_PARTICIPACION])
		formatString: 0.0
		lineageTag: e37b72b1-f693-4390-b727-d20d8308bcf3

	column anio
		dataType: int64
		formatString: 0
		lineageTag: df525c54-8389-48cb-99f3-b3c671b1d4aa
		summarizeBy: none
		sourceColumn: anio

		annotation SummarizationSetBy = User

	column TFR
		dataType: double
		formatString: 0.00
		lineageTag: c7804a7b-84ba-413f-85a0-72ec41f1c682
		summarizeBy: none
		sourceColumn: TFR

		annotation SummarizationSetBy = User

