table pbi_piramide
	lineageTag: 87e35293-4dec-4de7-8b9c-573b1d5fa26e

	/// % de la población total del año (se grafica a la izquierda)
	measure 'Hombres (%)' = VAR a = SELECTEDVALUE(pbi_anio_sel[anio_piramide], 2025) RETURN -CALCULATE(SUM(pbi_piramide[pct]), pbi_piramide[sexo] = "Hombres", pbi_piramide[anio] = a)
		formatString: 0.0;0.0
		lineageTag: 52ead66f-4591-4efd-9a9f-d77d52738175

	measure 'Mujeres (%)' = VAR a = SELECTEDVALUE(pbi_anio_sel[anio_piramide], 2025) RETURN CALCULATE(SUM(pbi_piramide[pct]), pbi_piramide[sexo] = "Mujeres", pbi_piramide[anio] = a)
		formatString: 0.0
		lineageTag: b0e6fff4-a21f-42c6-89a7-f9327b8ee679

	measure 'Año de la pirámide' = VAR a = SELECTEDVALUE(pbi_anio_sel[anio_piramide], 2025) RETURN a & IF(a <= 2022, " · estimada", " · proyección KOSTAT medio")
		lineageTag: 2a2075de-ae09-4c7d-9f6c-093f69e7896e

