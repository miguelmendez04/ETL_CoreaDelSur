/// Índice de riesgo demográfico por si-do (inferencia propia, 4 componentes con igual peso).
table pbi_riesgo
	lineageTag: 76fbb344-de63-445e-a6a7-c3b5690eef82

	/// Inferencia propia: 4 componentes normalizados 0-100 con igual peso (100 = mayor riesgo)
	measure 'Índice de riesgo' = AVERAGE(pbi_riesgo[indice_riesgo])
		formatString: 0.0
		lineageTag: 0a4a1d52-dd84-46d9-9d4e-b4cfe34d011c

	measure 'Si-do en riesgo alto' = CALCULATE(COUNTROWS(pbi_riesgo), pbi_riesgo[nivel_riesgo] = "Alto")
		formatString: 0
		lineageTag: c49a7f09-088e-41b4-8d01-e8880839a078

